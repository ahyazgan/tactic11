{
  "name": "tactic11-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "cmd /c ..\\launcher\\BASLAT.bat",
    "gelistirme": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "..\\venv\\Scripts\\python.exe ..\\scripts\\dev_api.py",
    "dev:web": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "demo": "npm run build && next start",
    "lint": "eslint src",
    "typecheck": "next typegen && tsc --noEmit",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.0",
    "hotkeys-js": "4.0.8",
    "konva": "10.7.1",
    "lucide-react": "0.577.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-konva": "19.3.0",
    "recharts": "^2.12.0",
    "swr": "^2.2.0",
    "tailwind-merge": "3.7.0",
    "tus-js-client": "4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "^5.5.0"
  }
}
